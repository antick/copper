{
  "name": "copper",
  "private": true,
  "version": "0.2.2",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "dev": "pnpm dev:desktop",
    "dev:desktop": "pnpm --filter @copper/desktop dev",
    "dev:landing": "pnpm --filter @copper/landing dev",
    "dev:web": "pnpm --filter @copper/desktop dev:web",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @copper/desktop build",
    "build:landing": "turbo run build --filter=@copper/landing",
    "build:web": "pnpm --filter @copper/desktop build:web",
    "package": "pnpm --filter @copper/desktop package",
    "preview": "pnpm --filter @copper/landing preview",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @copper/desktop test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "fixtures:perf": "pnpm --filter @copper/desktop fixtures:perf",
    "icons:generate": "pnpm --filter @copper/desktop icons:generate",
    "security:scan": "node scripts/scan-secrets.mjs",
    "release:build": "pnpm --filter @copper/desktop release:build",
    "release:publish": "pnpm --filter @copper/desktop release:publish"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.3"
  }
}
