{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": [
    "electron",
    "electron.vite.config.ts",
    "vitest.native.config.ts",
    "scripts/prepare-electron-app.mjs"
  ]
}
