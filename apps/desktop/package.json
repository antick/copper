{
  "name": "@copper/desktop",
  "productName": "Copper",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "vite",
    "build": "electron-vite build",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run --config vite.config.ts && vitest run --config vitest.native.config.ts",
    "test:watch": "vitest --config vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm test && pnpm typecheck && pnpm lint",
    "fixtures:perf": "node scripts/generate-perf-fixtures.mjs",
    "icons:generate": "node scripts/generate-app-icon.mjs",
    "release:build": "node scripts/build-release.mjs",
    "package": "pnpm build && electron-builder --publish never",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.6",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-virtual": "3.14.10",
    "better-sqlite3": "13.0.3",
    "chokidar": "5.0.0",
    "electron-updater": "6.8.9",
    "emoji-picker-react": "4.19.1",
    "lucide-react": "0.541.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "trash": "10.1.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "app.copper.desktop",
    "buildVersion": "0.1.0",
    "productName": "Copper",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/icons/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/icons/copper.icns",
        "to": "Copper.icns"
      },
      {
        "from": "resources/icons/icon.png",
        "to": "Copper.png"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icons/copper.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleIconFile": "Copper.icns",
        "CFBundleName": "Copper",
        "CFBundleDisplayName": "Copper"
      },
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Copper-${version}-mac-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "antick",
      "repo": "copper"
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Copper-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Office",
      "executableName": "copper",
      "maintainer": "Pankaj <antick@users.noreply.github.com>",
      "icon": "resources/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "appImage": {
      "artifactName": "Copper-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageName": "copper",
      "artifactName": "copper_${version}_${arch}.${ext}"
    }
  },
  "description": "A local-first workspace for notes, tasks, and projects.",
  "homepage": "https://copper.potion.sh",
  "author": {
    "name": "Pankaj",
    "email": "antick@users.noreply.github.com"
  }
}
